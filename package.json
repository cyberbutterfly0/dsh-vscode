{
  "name": "dsh-vscode",
  "displayName": "DSH for VS Code",
  "description": "把 DeepSeek Harness (dsh) 接进 VS Code：自绘聊天面板 + 一键切换完整 dsh Web UI。",
  "version": "0.2.1",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dsh.openChatView",
        "title": "打开侧栏聊天",
        "category": "dsh"
      },
      {
        "command": "dsh.openChat",
        "title": "打开聊天",
        "category": "DSH"
      },
      {
        "command": "dsh.newSession",
        "title": "新建会话",
        "category": "DSH"
      },
      {
        "command": "dsh.connectExisting",
        "title": "连接已有实例（粘贴 tokenized URL）",
        "category": "DSH"
      },
      {
        "command": "dsh.restartRuntime",
        "title": "重启内置 runtime",
        "category": "DSH"
      },
      {
        "command": "dsh.disconnect",
        "title": "断开连接",
        "category": "DSH"
      },
      {
        "command": "dsh.openFullUI",
        "title": "打开完整 dsh UI",
        "category": "DSH"
      },
      {
        "command": "dsh.selectModel",
        "title": "选择模型",
        "category": "DSH"
      },
      {
        "command": "dsh.selectPermission",
        "title": "选择权限档",
        "category": "DSH"
      },
      {
        "command": "dsh.pickWorkspace",
        "title": "选择工作区目录",
        "category": "DSH"
      },
      {
        "command": "dsh.showLog",
        "title": "显示日志",
        "category": "DSH"
      },
      {
        "command": "dsh.revealState",
        "title": "打开凭据文件",
        "category": "DSH"
      },
      {
        "command": "dsh.refreshSessions",
        "title": "刷新会话列表",
        "category": "DSH",
        "icon": "$(refresh)"
      },
      {
        "command": "dsh.explainSelection",
        "title": "把选中的代码发给 DSH",
        "category": "DSH"
      },
      {
        "command": "dsh.askAboutFile",
        "title": "就当前文件问 DSH",
        "category": "DSH"
      },
      {
        "command": "dsh.renameSession",
        "title": "重命名会话",
        "category": "DSH",
        "icon": "$(edit)"
      },
      {
        "command": "dsh.zoomFullUi",
        "title": "缩放完整 dsh UI",
        "category": "DSH"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dshContainer",
          "title": "DSH",
          "icon": "media/dsh.svg"
        }
      ]
    },
    "views": {
      "dshContainer": [
        {
          "id": "dsh.chatView",
          "name": "聊天",
          "type": "webview",
          "visibility": "visible"
        },
        {
          "id": "dsh.sessions",
          "name": "会话"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dsh.sessions",
        "contents": "还没有连接 dsh。\n[启动内置 runtime](command:dsh.restartRuntime)\n[连接已有实例](command:dsh.connectExisting)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dsh.newSession",
          "when": "view == dsh.sessions",
          "group": "navigation@1"
        },
        {
          "command": "dsh.openFullUI",
          "when": "view == dsh.sessions",
          "group": "navigation@2"
        },
        {
          "command": "dsh.refreshSessions",
          "when": "view == dsh.sessions",
          "group": "navigation@3"
        },
        {
          "command": "dsh.restartRuntime",
          "when": "view == dsh.sessions",
          "group": "dsh@1"
        },
        {
          "command": "dsh.disconnect",
          "when": "view == dsh.sessions",
          "group": "dsh@2"
        }
      ],
      "commandPalette": [
        {
          "command": "dsh.revealState"
        }
      ],
      "editor/context": [
        {
          "command": "dsh.explainSelection",
          "when": "editorHasSelection",
          "group": "dsh@1"
        },
        {
          "command": "dsh.askAboutFile",
          "when": "editorLangId != \"\"",
          "group": "dsh@2"
        }
      ],
      "explorer/context": [
        {
          "command": "dsh.askAboutFile",
          "when": "resourceScheme == file",
          "group": "dsh@1"
        }
      ],
      "view/item/context": [
        {
          "command": "dsh.renameSession",
          "when": "view == dsh.sessions && viewItem =~ /^dsh\\.session/",
          "group": "dsh@1"
        }
      ]
    },
    "configuration": {
      "title": "DSH",
      "properties": {
        "dsh.mode": {
          "type": "string",
          "enum": [
            "auto",
            "spawn",
            "attach"
          ],
          "enumDescriptions": [
            "优先复用记忆的连接；没有则启动内置 runtime",
            "总是自己启动 dsh web --port 0 --no-open",
            "总是连接已有实例（需要 tokenized URL）"
          ],
          "default": "auto",
          "description": "runtime 获取方式。"
        },
        "dsh.cliPath": {
          "type": "string",
          "default": "dsh",
          "description": "dsh 可执行文件路径。留空则自动探测全局 npm 安装。"
        },
        "dsh.attachUrl": {
          "type": "string",
          "default": "",
          "description": "已有实例的 tokenized URL，例如 http://127.0.0.1:3080/?token=xxx。建议用「DSH: 连接已有实例」命令填写。"
        },
        "dsh.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "VS Code 启动时自动建立连接。"
        },
        "dsh.defaultCwd": {
          "type": "string",
          "default": "",
          "description": "新建会话的默认工作目录。留空用当前 VS Code 工作区。"
        },
        "dsh.defaultPermission": {
          "type": "string",
          "enum": [
            "read-only",
            "workspace-write",
            "danger-full-access",
            "auto"
          ],
          "enumDescriptions": [
            "只读：不能改文件",
            "工作区可写：只能改当前工作区内的文件",
            "完全访问：能读写任意路径（危险，会弹审批）",
            "自动：由 dsh 自己判断"
          ],
          "default": "workspace-write",
          "description": "新会话默认权限档。"
        },
        "dsh.extraSpawnArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "启动内置 runtime 时附加给 dsh web 的参数。"
        },
        "dsh.logLevel": {
          "type": "string",
          "enum": [
            "off",
            "error",
            "info",
            "debug"
          ],
          "default": "info",
          "description": "扩展日志级别。"
        },
        "dsh.sendWorkspaceContext": {
          "type": "boolean",
          "default": true,
          "description": "把当前活动文件与选区作为上下文前缀发给会话。"
        },
        "dsh.openViewOnStart": {
          "type": "boolean",
          "default": false,
          "description": "启动时自动打开侧栏聊天视图。"
        },
        "dsh.fullUiZoom": {
          "type": "number",
          "default": 1,
          "minimum": 0.5,
          "maximum": 1.5,
          "description": "完整 dsh UI（iframe）的缩放比例。窗口窄时调小一点能少滚动。"
        },
        "dsh.startTimeoutMs": {
          "type": "number",
          "default": 45000,
          "minimum": 5000,
          "maximum": 300000,
          "description": "自己启动 dsh 时，等它打印 Web 地址的最长毫秒数。机器慢就调大。"
        },
        "dsh.stopOnExit": {
          "type": "boolean",
          "default": false,
          "description": "关闭 VS Code 时是否顺带杀掉扩展自己启动的 dsh 进程。连的是别人启动的实例时永远不动。"
        },
        "dsh.env": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "启动 dsh 时追加的环境变量，例如 { \"HTTPS_PROXY\": \"http://127.0.0.1:7890\" }。"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "vsix": "node scripts/make-vsix.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:editor-context": "node scripts/test-editor-context.mjs",
    "install:local": "node scripts/install-local.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cyberbutterfly0/dsh-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/cyberbutterfly0/dsh-vscode/issues"
  },
  "homepage": "https://github.com/cyberbutterfly0/dsh-vscode#readme"
}


